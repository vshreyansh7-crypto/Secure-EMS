{
  "name": "exam-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "start": "electron .",
    "build:electron": "electron-builder"
  },
  "dependencies": {
    "face-api.js": "^0.22.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  },
  "main": "main.cjs",
  "build": {
    "appId": "com.secureems.app",
    "productName": "Secure EMS",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "../backend/dist-backend",
        "to": "dist-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "main.cjs"
    ]
  }
}
